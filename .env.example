# ===== 本地运行安全边界 =====
# 默认只允许本机访问 API。需要反向代理或远程访问时，设为 0，并同时设置 LUMON_ACCESS_TOKEN。
LUMON_LOCAL_ONLY=1
# 仅由绑定到 127.0.0.1 的本地容器编排设置；普通运行不要开启。
LUMON_TRUST_LOCAL_PROXY=0
LUMON_ACCESS_TOKEN=
# 远程模式必须改成实际 HTTPS 前端来源，多个来源用逗号分隔，不支持通配符。
LUMON_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LUMON_MAX_REQUEST_BYTES=8388608

# ===== GPT 配置（由运行 Lumon 的用户自行提供） =====
GPT_BASE_URL=
GPT_API_KEY=
GPT_MODEL=gpt-5.4-mini

# ===== Claude 配置（可选） =====
CLAUDE_BASE_URL=
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-4-6

# ===== 搜索引擎（可选） =====
TAVILY_API_KEY=

# ===== 飞书集成（可选，使用当前 Session 的用户凭据） =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
